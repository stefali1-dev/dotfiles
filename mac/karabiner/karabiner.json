{
    "global": {
        "show_in_menu_bar": false
    },
    "profiles": [
        {
            "name": "Default profile",
            "selected": true,
            "simple_modifications": [
                {
                    "from": {
                        "key_code": "caps_lock"
                    },
                    "to": [
                        {
                            "key_code": "left_control"
                        }
                    ]
                },
                {
                    "from": {
                        "key_code": "right_option"
                    },
                    "to": [
                        {
                            "key_code": "right_control"
                        }
                    ]
                }
            ],
            "virtual_hid_keyboard": {
                "keyboard_type_v2": "ansi"
            },
            "complex_modifications": {
                "rules": [
                    {
                        "description": "Cmd+B opens a Brave window, as on Omarchy (not in apps where Cmd+B means bold or sidebar)",
                        "manipulators": [
                            {
                                "type": "basic",
                                "from": {
                                    "key_code": "b",
                                    "modifiers": {
                                        "mandatory": [
                                            "command"
                                        ],
                                        "optional": [
                                            "caps_lock"
                                        ]
                                    }
                                },
                                "to": [
                                    {
                                        "shell_command": "open -na 'Brave Browser' --args --new-window"
                                    }
                                ],
                                "conditions": [
                                    {
                                        "type": "frontmost_application_unless",
                                        "bundle_identifiers": [
                                            "^com\\.brave\\.Browser$",
                                            "^com\\.tinyspeck\\.slackmacgap$",
                                            "^com\\.microsoft\\.VSCode$",
                                            "^com\\.todesktop\\.230313mzl4w4u92$",
                                            "^md\\.obsidian$",
                                            "^com\\.apple\\.Notes$",
                                            "^com\\.apple\\.iWork\\.Pages$",
                                            "^com\\.apple\\.iWork\\.Keynote$",
                                            "^com\\.apple\\.iWork\\.Numbers$"
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "description": "Cmd+Shift+F opens Yazi, as on Omarchy (not in editors, where it's Find in Files)",
                        "manipulators": [
                            {
                                "type": "basic",
                                "from": {
                                    "key_code": "f",
                                    "modifiers": {
                                        "mandatory": [
                                            "command",
                                            "shift"
                                        ],
                                        "optional": [
                                            "caps_lock"
                                        ]
                                    }
                                },
                                "to": [
                                    {
                                        "shell_command": "open -a Yazi"
                                    }
                                ],
                                "conditions": [
                                    {
                                        "type": "frontmost_application_unless",
                                        "bundle_identifiers": [
                                            "^com\\.microsoft\\.VSCode$",
                                            "^com\\.todesktop\\.230313mzl4w4u92$"
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
