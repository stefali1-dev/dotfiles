#!/bin/bash
# Runs the TUI update.sh built, with the Node version its checkout pins (so re-pointing `current` is a full rollback).
dir=~/.local/share/zcode-tui/current
node=$(sed -n 's/^node = "\(.*\)"$/\1/p' "$dir/mise.toml")
state=~/.local/bin/zcode-herdr-agent-state
# Installed on Omarchy only: the Mac has no herdr.
[ -x "$state" ] || state=:

# Only the TUI reports to herdr: a headless run or subcommand would take over the calling pane's (e.g. Claude's) state.
tui=1
case ${1:-} in "" | tui | -*) ;; *) tui= ;; esac
for arg in "$@"; do
  case $arg in -p | --prompt* | --target* | -h | --help | -v | --version) tui= ;; esac
done
[ "$tui" ] || unset HERDR_ENV

"$state" start
mise x "node@$node" -- node "$dir/apps/zcode-cli/packages/cli/dist/zcode.cjs" "$@"
status=$?
"$state" exit
exit $status
