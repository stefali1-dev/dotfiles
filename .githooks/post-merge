#!/usr/bin/env bash
# After a pull that changed theme/, apply the new Omarchy theme to this Mac's apps.
# Omarchy applies its own themes, so this is macOS-only.
set -euo pipefail

[ "$(uname -s)" = Darwin ] || exit 0

root="$(git rev-parse --show-toplevel)"
[ -x "$root/mac/theme-set.sh" ] || exit 0

# What HEAD was before this merge. A fast-forward pull doesn't always leave ORIG_HEAD behind.
before=$(git rev-parse --verify --quiet ORIG_HEAD || git rev-parse --verify --quiet 'HEAD@{1}' || true)
[ -n "$before" ] || exit 0

if git diff-tree -r --name-only --no-commit-id "$before" HEAD | grep -q '^theme/'; then
  echo "theme/ changed; applying it to this Mac"
  "$root/mac/theme-set.sh"
fi
