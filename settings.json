{
  "model": "opus",
  "theme": "dark",
  "agentPushNotifEnabled": true,
  "permissions": {
    "allow": [
      "Bash(cdk deploy:*)",
      "Bash(npx cdk deploy:*)",
      "Bash(./my-docs/ui-testing/serve.sh:*)",
      "Bash(./my-docs/ui-testing/stop.sh:*)",
      "Bash(node my-docs/ui-testing/:*)",
      "Bash(npm run infrastructure:cdk:*)"
    ],
    "additionalDirectories": [
      "/Users/stefan.leustean/agent-docs"
    ]
  },
  "fileSuggestion": {
    "type": "command",
    "command": "~/.claude/file-suggestion.sh"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/agent-docs.sh"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "head"
  }
}
