{
  "fileSuggestion": {
    "type": "command",
    "command": "~/.claude/file-suggestion.sh"
  },
  "permissions": {
    "additionalDirectories": [
      "~/agent-docs"
    ],
    "allow": [
      "Bash(node /home/stefan/dotfiles/omarchy/zcode/usage.mjs:*)",
      "Bash(/home/stefan/dotfiles/omarchy/zcode/usage.mjs:*)",
      "Bash(zcode-usage:*)",
      "Bash(/home/stefan/.local/bin/zcode-usage:*)",
      "Read(//home/stefan/.local/share/zcode-tui/**)",
      "Read(//home/stefan/Applications/zcode/**)"
    ]
  },
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/agent-docs.sh"
          }
        ]
      },
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/herdr-agent-state.sh session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "head"
  },
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "theme": "custom:omarchy",
  "switchModelsOnFlag": true,
  "agentPushNotifEnabled": true,
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  }
}
