# zsh on every machine. Loads this OS's <os>/zsh.zsh from the repo, then the
# untracked ~/.zshrc.local for machine-only settings and secrets.

# History
HISTFILE=~/.zsh_history
HISTSIZE=32768
SAVEHIST=$HISTSIZE
setopt share_history hist_ignore_dups hist_ignore_space extended_history

setopt auto_cd interactive_comments no_beep

# Aliases
alias cl='clear'
alias gs='git status'

# Claude Code: trust every folder. Undocumented flag; unlike trust recorded in
# ~/.claude.json, it also covers features that check only the exact launch folder.
export CLAUDE_CODE_SANDBOXED=1

# Repo root, found through the ~/.zshrc symlink
dotfiles=${${(%):-%x}:A:h:h}
case $OSTYPE in
  darwin*) source "$dotfiles/mac/zsh.zsh" ;;
  linux*) source "$dotfiles/omarchy/zsh.zsh" ;;
esac
unset dotfiles

[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local
